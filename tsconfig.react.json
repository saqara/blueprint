{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["registry/react", "src/react", "scripts", "lib"]
}
