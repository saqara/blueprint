        "light": {
          "radius": "0.375rem",
          "background": "#FFFFFF",
          "foreground": "#292524",
          "card": "#FFFFFF",
          "card-foreground": "#292524",
          "popover": "#FFFFFF",
          "popover-foreground": "#292524",
          "primary": "#F04632",
          "primary-foreground": "#FFFFFF",
          "secondary": "#F5F5F4",
          "secondary-foreground": "#1C1917",
          "muted": "#F5F5F4",
          "muted-foreground": "#57534E",
          "accent": "#FDECEB",
          "accent-foreground": "#B32019",
          "destructive": "#C2002C",
          "destructive-foreground": "#FFFFFF",
          "border": "#E7E5E4",
          "input": "#E7E5E4",
          "ring": "#F04632",
          "identity": "#F04632",
          "identity-foreground": "#FFFFFF",
          "navy": "#283549",
          "navy-foreground": "#FFFFFF",
          "success": "#6EBD71",
          "success-foreground": "#0C0A09",
          "warning": "#E59A06",
          "warning-foreground": "#0C0A09",
          "info": "#0A5CD6",
          "info-foreground": "#FFFFFF",
          "shadow": "rgba(155,154,154,.3)",
          "sidebar": "#FAFAF9",
          "sidebar-foreground": "#292524",
          "sidebar-primary": "#F04632",
          "sidebar-primary-foreground": "#FFFFFF",
          "sidebar-accent": "#F5F5F4",
          "sidebar-accent-foreground": "#1C1917",
          "sidebar-border": "#E7E5E4",
          "sidebar-ring": "#F04632"
        },
        "dark": {
          "radius": "0.375rem",
          "background": "#0C0A09",
          "foreground": "#FAFAF9",
          "card": "#1C1917",
          "card-foreground": "#FAFAF9",
          "popover": "#1C1917",
          "popover-foreground": "#FAFAF9",
          "primary": "#F04632",
          "primary-foreground": "#FFFFFF",
          "secondary": "#292524",
          "secondary-foreground": "#FAFAF9",
          "muted": "#292524",
          "muted-foreground": "#A8A29E",
          "accent": "#292524",
          "accent-foreground": "#FAFAF9",
          "destructive": "#FF5A6E",
          "destructive-foreground": "#0C0A09",
          "border": "#292524",
          "input": "#44403C",
          "ring": "#F04632",
          "identity": "#F04632",
          "identity-foreground": "#FFFFFF",
          "navy": "#283549",
          "navy-foreground": "#FFFFFF",
          "success": "#6EBD71",
          "success-foreground": "#0C0A09",
          "warning": "#E59A06",
          "warning-foreground": "#0C0A09",
          "info": "#0A5CD6",
          "info-foreground": "#FFFFFF",
          "shadow": "rgba(0,0,0,.6)",
          "sidebar": "#1C1917",
          "sidebar-foreground": "#FAFAF9",
          "sidebar-primary": "#F04632",
          "sidebar-primary-foreground": "#FFFFFF",
          "sidebar-accent": "#292524",
          "sidebar-accent-foreground": "#FAFAF9",
          "sidebar-border": "#292524",
          "sidebar-ring": "#F04632"
        }
