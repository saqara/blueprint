    {
      "name": "saqara-theme",
      "type": "registry:theme",
      "title": "Saqara theme",
      "description": "Couleurs, polices et ombres Saqara (clair + sombre).",
      "dependencies": [
        "@fontsource/lato",
        "@fontsource/poppins"
      ],
      "cssVars": {
        "theme": {
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
          "color-card": "var(--card)",
