    "chart-1": "#F04632",
    "chart-2": "#8FA3BF",
    "chart-3": "#4C8DF6",
    "chart-4": "#6EBD71",
    "chart-5": "#E59A06",
    "elevation-2xs": "0 1px 0 0 rgb(0 0 0 / 0.16)",
    "elevation-xs": "0 1px 2px 0 rgb(0 0 0 / 0.18)",
    "elevation-sm": "0 1px 2px 0 rgb(0 0 0 / 0.12), 0 1px 3px 0 rgb(0 0 0 / 0.16)",
    "elevation-md": "0 2px 4px -1px rgb(0 0 0 / 0.12), 0 4px 6px -1px rgb(0 0 0 / 0.18)",
    "elevation-lg": "0 4px 6px -2px rgb(0 0 0 / 0.10), 0 10px 15px -3px rgb(0 0 0 / 0.18)",
    "elevation-xl": "0 10px 10px -5px rgb(0 0 0 / 0.08), 0 20px 25px -5px rgb(0 0 0 / 0.20)",
    "elevation-card": "0 1px 1px 0 rgb(0 0 0 / 0.14)",
    "elevation-dropdown": "0 0 0 1px rgb(255 255 255 / 0.06), 0 1px 1px 0 rgb(0 0 0 / 0.14), 0 4px 12px 0 rgb(0 0 0 / 0.24)",
    "elevation-panel": "0 1px 0 0 rgb(0 0 0 / 0.10), 0 1px 12px 0 rgb(0 0 0 / 0.16), 0 0 1px 0 rgb(0 0 0 / 0.42)",
    "elevation-raised": "inset 0 1px 0 0 rgb(255 255 255 / 0.18), inset 0 0 0 1px rgb(0 0 0 / 0.20), 0 1px 2px 0 rgb(0 0 0 / 0.40)",
    "elevation-pressed": "inset 0 1px 2px 0 rgb(0 0 0 / 0.40)",
    "elevation-nav-selected": "0 0 0 1px var(--identity), inset 0 1px 0 0 rgb(255 255 255 / 0.08), 0 1px 2px 0 rgb(0 0 0 / 0.40)"
  },
  "theme": {
    "font-sans": "\"Geist Variable\", ui-sans-serif, system-ui, sans-serif",
    "font-heading": "Poppins, ui-sans-serif, system-ui, sans-serif",
    "radius-sm": "calc(var(--radius) - 2px)",
    "radius-md": "var(--radius)",
    "radius-lg": "calc(var(--radius) + 2px)",
    "radius-xl": "calc(var(--radius) + 4px)",
    "font-mono": "\"Maple Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
    "text-xs": "0.75rem",
    "text-xs--line-height": "1rem",
    "text-sm": "0.8125rem",
    "text-sm--line-height": "1.25rem",
    "text-base": "0.875rem",
    "text-base--line-height": "1.25rem",
    "text-lg": "1rem",
    "text-lg--line-height": "1.375rem",
    "text-3xl": "1.75rem",
    "text-3xl--line-height": "2.125rem",
    "ease-tail": "cubic-bezier(.23,1,.32,1)",
    "ease-spring": "linear(0, .5729, .8966, .9789, .996, 1, 1)",
    "ease-spring-bounce": "linear(0, .3878, .7777, .9458, .9946, 1.0029, 1.0021, 1)",
    "shadow-2xs": "var(--elevation-2xs)",
    "shadow-xs": "var(--elevation-xs)",
    "shadow-sm": "var(--elevation-sm)",
    "shadow-md": "var(--elevation-md)",
    "shadow-lg": "var(--elevation-lg)",
    "shadow-xl": "var(--elevation-xl)",
    "shadow-card": "var(--elevation-card)",
    "shadow-dropdown": "var(--elevation-dropdown)",
    "shadow-panel": "var(--elevation-panel)",
    "shadow-raised": "var(--elevation-raised)",
    "shadow-pressed": "var(--elevation-pressed)",
    "shadow-nav-selected": "var(--elevation-nav-selected)"
  },
  "css": {
    "@import \"tw-animate-css\"": {},
    "@import \"@fontsource-variable/geist\"": {},
    "@import \"@fontsource/poppins/400.css\"": {},
    "@import \"@fontsource/poppins/500.css\"": {},
    "@import \"@fontsource/poppins/600.css\"": {},
    "@import \"@fontsource/maple-mono/400.css\"": {},
    "@import \"@fontsource/maple-mono/600.css\"": {},
    "@custom-variant dark (&:is(.dark *))": {},
    "@layer base": {
      "*": {
        "@apply border-border outline-ring/50": {}
      },
      "body": {
        "@apply bg-background text-foreground": {}
      },
      "h1, h2, h3, h4, h5, h6": {
        "@apply font-heading": {}
      },
      "@media (prefers-reduced-motion: reduce)": {
        "*": {
          "--tw-enter-scale": "1 !important",
          "--tw-exit-scale": "1 !important",
          "--tw-enter-translate-x": "0 !important",
          "--tw-enter-translate-y": "0 !important",
          "--tw-exit-translate-x": "0 !important",
          "--tw-exit-translate-y": "0 !important"
        }
      }
    },
    "@utility raised": {
      "position": "relative",
      "isolation": "isolate",
      "background-color": "var(--raised-color)",
      "background-image": "linear-gradient(180deg, color-mix(in oklab, var(--raised-color) 86%, white), color-mix(in oklab, var(--raised-color) 90%, black))",
      "box-shadow": "var(--elevation-raised)",
      "&::before": {
        "content": "\"\"",
        "position": "absolute",
        "inset": "0",
        "z-index": "-1",
        "border-radius": "inherit",
        "pointer-events": "none",
        "background-image": "linear-gradient(180deg, color-mix(in oklab, var(--raised-color) 74%, white), var(--raised-color))",
        "opacity": "0",
        "transition": "opacity 160ms ease"
      },
      "&:hover:not(:disabled):not([aria-disabled=true])::before": {
        "opacity": "1"
      },
      "&:active:not(:disabled):not([aria-disabled=true])": {
        "background-image": "linear-gradient(180deg, color-mix(in oklab, var(--raised-color) 88%, black), color-mix(in oklab, var(--raised-color) 80%, black))",
        "box-shadow": "var(--elevation-pressed)"
      },
      "&:active:not(:disabled):not([aria-disabled=true])::before": {
        "opacity": "0"
      }
    }
  }
}
